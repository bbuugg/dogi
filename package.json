{
  "name": "opsdesk",
  "version": "0.1.0",
  "description": "AI 驱动的运维终端工具",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "copy:monaco": "node scripts/copy-monaco.cjs",
    "predev": "npm run copy:monaco",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run copy:monaco && npm run build:plugins",
    "build:plugins": "node scripts/build-plugins.mjs",
    "create:plugin": "node scripts/create-plugin.mjs",
    "build": "npm run typecheck && vite build -c vite.main.mts && vite build -c vite.preload.mts && vite build",
    "start": "electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/deepseek": "^3.0.44",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@opsdesk/ai-agent": "*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.99",
    "antd": "^6.6.4",
    "cn": "^0.3.0",
    "electron-store": "^11.0.2",
    "lucide-react": "^1.45.0",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.16.0",
    "zmodem.js": "^0.1.10",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "electron@44.3.0": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.opsdesk.app",
    "productName": "OpsDesk",
    "copyright": "Copyright © 2026",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/node-pty/**",
      "**/node_modules/cpu-features/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "OpsDesk"
    }
  }
}
