{
  "name": "dogi",
  "version": "0.0.18",
  "description": "AI 驱动的研发运维工作台",
  "author": "Dogi",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "copy:monaco": "node scripts/copy-monaco.cjs",
    "copy:rdp": "node scripts/copy-rdp.cjs",
    "predev": "npm run copy:monaco && npm run copy:rdp",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run copy:monaco && npm run copy:rdp",
    "build": "npm run typecheck && vite build -c vite.main.mts && vite build -c vite.preload.mts && vite build",
    "start": "electron .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/deepseek": "^3.0.44",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@mastra/core": "^1.71.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@playwright/mcp": "^0.0.82",
    "ai": "^7.0.99",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "ironrdp-wasm": "^1.1.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.63.0",
    "ssh2": "^1.16.0",
    "undici": "^7.30.0",
    "ws": "^8.22.0",
    "zod": "^4.6.4"
  },
  "overrides": {
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "^1.12.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@milkdown/react": "^7.22.2",
    "@monaco-editor/react": "^4.7.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.4",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "electron": "^44.3.0",
    "electron-builder": "^25.1.8",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.45.0",
    "media-chrome": "^4.19.2",
    "monaco-editor": "^0.56.0",
    "motion": "^13.4.4",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "react-jsx-parser": "^2.4.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "streamdown": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^8.3.0",
    "zmodem.js": "^0.1.10",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true,
    "electron@44.3.0": true,
    "node-pty@1.1.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbuugg/dogi.git"
  },
  "build": {
    "appId": "com.dogi.app",
    "productName": "Dogi",
    "copyright": "Copyright © 2026",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "bbuugg",
        "repo": "dogi"
      }
    ],
    "files": [
      "out/**/*",
      "!out/{main,preload}-tmp/**",
      "plugins/**/*",
      "!plugins/**/node_modules/**",
      "!plugins/**/src/**",
      "!plugins/**/.git/**",
      "package.json",
      "!**/*.map",
      "!**/*.test.js",
      "!**/*.spec.js",
      "!**/{test,tests,__tests__,__mocks__,spec,docs,example,examples}/**",
      "!**/node_modules/node-pty/prebuilds/win32-arm64/**"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "resources/app-icon.png",
        "to": "app-icon.png"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/node-pty/**",
      "**/node_modules/cpu-features/**",
      "**/node_modules/playwright/**",
      "**/node_modules/playwright-core/**",
      "**/node_modules/@playwright/mcp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "electronLanguages": [
        "en",
        "zh_CN"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Dogi"
    }
  }
}
