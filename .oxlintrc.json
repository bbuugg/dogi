{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react"],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-server/**",
    "**/build/**",
    "out/**",
    "release/**",
    "**/monaco-editor/**",
    "apps/mobile/android/**",
    "apps/mobile/www/**",
    ".fizz/**",
    ".trae/**",
    ".tooltest/**",
    ".workbuddy/**",
    ".workbuddy-ai/**",
    ".playwright-cli/**",
    "screenshots/**",
    "skills/**",
    "plugins/**",
    "resources/**",
    "docker/**"
  ]
}
