{
  "name": "@fizz/desktop",
  "version": "0.0.8",
  "description": "Fizz",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/bbuugg/fizz.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "productName": "Fizz",
  "author": "bbuugg",
  "scripts": {
    "build:main": "vite build -c vite.main.mts",
    "build:preload": "vite build -c vite.preload.mts",
    "build:renderer": "vite build -c vite.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "pack:dir": "npm run build:web --prefix ../.. && npm run build:mobile:hosted --prefix ../.. && npm run build && electron-builder --dir",
    "pack": "npm run build:web --prefix ../.. && npm run build:mobile:hosted --prefix ../.. && npm run build && electron-builder --publish never",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/deepseek": "^3.0.44",
    "@ai-sdk/google": "^4.0.69",
    "@ai-sdk/openai": "^4.0.66",
    "@hono/node-server": "^1.19.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.99",
    "dockerode": "^5.0.1",
    "dotenv": "^16.6.1",
    "electron-updater": "^6.8.9",
    "hono": "^4.10.3",
    "iconv-lite": "^0.6.3",
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.56.0",
    "simple-git": "^4.0.2",
    "ssh2": "^1.17.0",
    "turndown": "^7.2.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fizz/agent-client": "*",
    "@fizz/agent-host": "*",
    "@fizz/agent-kit": "*",
    "@fizz/contracts": "*",
    "@fizz/shells": "*",
    "@fizz/ui": "*",
    "@fizz/ui-tokens": "*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.9.3",
    "electron-builder": "^25.1.8",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.fizz.agent",
    "productName": "Fizz",
    "copyright": "Copyright © 2026",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "bbuugg",
        "repo": "fizz"
      }
    ],
    "electronDist": "../../node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json",
      "!**/node_modules/node-pty/build/**",
      "!**/node_modules/node-pty/prebuilds/darwin-*",
      "!**/node_modules/node-pty/prebuilds/win32-arm64",
      "!**/node_modules/node-pty/**/*.pdb",
      "!**/node_modules/node-pty/**/*.iobj",
      "!**/node_modules/node-pty/**/*.ipdb",
      "!**/node_modules/node-pty/**/*.lib",
      "!**/node_modules/node-pty/**/*.exp",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.pdb",
      "!**/node_modules/**/*.iobj",
      "!**/node_modules/**/*.ipdb"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": "../../apps/web/dist",
        "to": "web-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../apps/mobile/dist-server",
        "to": "mobile-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../acp",
        "to": "acp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../plugins",
        "to": "plugins",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../docker",
        "to": "docker",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../.dockerignore",
        "to": ".dockerignore"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../../build/icon.ico",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "../../build/icons"
    }
  }
}
