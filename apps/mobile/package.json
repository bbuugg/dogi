{
  "name": "@fizz/mobile",
  "version": "0.0.13",
  "description": "Fizz 安卓壳：Capacitor + 独立 vite 工程（本地 www，服务端地址登录时配置）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "vite build",
    "build:hosted": "vite build --mode hosted",
    "preview": "vite preview --port 5181 --strictPort",
    "add:android": "cap add android",
    "assets": "node scripts/copy-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "sync": "cap sync android && npm run assets && node scripts/set-android-version.mjs && node scripts/configure-android-signing.mjs",
    "open": "cap open android",
    "build:android": "node scripts/set-android-version.mjs && node scripts/configure-android-signing.mjs && node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fizz/agent-client": "*",
    "@fizz/agent-kit": "*",
    "@fizz/contracts": "*",
    "@fizz/shells": "*",
    "@fizz/ui": "*",
    "@fizz/ui-tokens": "*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
