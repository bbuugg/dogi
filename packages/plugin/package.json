{
  "name": "@fizz/plugin",
  "version": "0.1.0",
  "description": "Fizz 的插件元框架（Cordis 风格精简版）：服务容器 Context、effect 逆序回收、依赖注入 inject、插件挂载 Fork、类型化事件；三服务 ctx.tools / ctx.prompt / ctx.events，外加轻服务 ctx.ui，源码直接被打包",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "default": "./src/config.ts"
    },
    "./loader": {
      "types": "./src/loader.ts",
      "default": "./src/loader.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
}