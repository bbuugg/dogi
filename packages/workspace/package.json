{
  "name": "@fizz/workspace",
  "version": "0.1.0",
  "description": "Fizz 的领域与存储：JsonStore 持久化（数据目录 FIZZ_DATA_DIR）、AgentDomain（工作区/会话/模型/Agent 配置）、TriggerDomain（定时任务），源码直接被打包",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./src/env.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fizz/acp": "*",
    "@fizz/contracts": "*",
    "@fizz/i18n": "*",
    "@fizz/mcp": "*",
    "@fizz/plugin": "*",
    "@fizz/skills": "*",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
}
