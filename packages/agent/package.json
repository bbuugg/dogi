    "@fizz/contracts": "*",
    "@fizz/i18n": "*",
    "@fizz/plugin": "*",
    "@fizz/skills": "*",
    "@fizz/tools": "*",
    "@mastra/core": "^1.68.0",
    "ai": "^7.0.99",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^7.0.2"
  }
