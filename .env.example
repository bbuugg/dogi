# Fizz 配置模板：复制成 .env 再改（.env 不入库）
#
#   本地开发：.env 放在仓库根，server 启动时会自动读（真实环境变量优先于文件）
#   Docker  ：docker compose 也会读同目录的 .env，用来做 ${...} 变量替换

# ---------------------------------------------------------------------------
# 登录鉴权（生产环境建议配置）
# ---------------------------------------------------------------------------
# 单用户系统：只配密码和 JWT 密钥即可启用（POST /api/auth/login 换服务端签发的 JWT，
# 默认 30 分钟），之后 HTTP 走 Authorization: Bearer、WS 走 ?token=。
# FIZZ_AUTH_PASS **只保存哈希**：先留空，首次登录时输入什么密码就把它哈希后写回这里。
# 也可以手工填一个 scrypt 哈希（格式 scrypt$N$r$p$salt$hash）。
# 不配置 FIZZ_JWT_SECRET = 鉴权未启用，开发态全部放行。
# FIZZ_AUTH_PASS=
# FIZZ_JWT_SECRET=换成随机串（openssl rand -base64 32）
# 登录 JWT 有效期（分钟），默认 30
# FIZZ_TOKEN_TTL=30

# 登录验证码（滑块拖拽）：鉴权启用时**默认开启**，设 0/false/off 关闭。
# ⚠️ CLI（fizz login / fizz chat）走的是同一个 POST /api/auth/login，命令行没法拖滑块 ——
#    用 CLI 时请把它设为 0（或等后续给 CLI 加机器客户端通道）。
# FIZZ_AUTH_CAPTCHA=0
#
# 验证码是**进程内实现**（apps/server/src/lib/captcha）：背景图 + 拼图块现画成 PNG，
# 答案只留在内存，前端拖完把 x 与轨迹 POST 回来换一次性票据。不依赖任何外部服务 / SDK。
# 下面都是可选的尺寸与风控参数，留空即用默认值。
# 画布尺寸（像素）
# FIZZ_CAPTCHA_WIDTH=320
# FIZZ_CAPTCHA_HEIGHT=160
# 拼图块边长 / 允许的位置误差（像素）
# FIZZ_CAPTCHA_PIECE_SIZE=44
# FIZZ_CAPTCHA_TOLERANCE=6
# 干扰块数量
# FIZZ_CAPTCHA_DECOYS=2
# 挑战有效期（秒）、票据有效期（秒）
# FIZZ_CAPTCHA_TTL_SEC=120
# FIZZ_CAPTCHA_PASS_TTL_SEC=300
# 轨迹耗时区间（毫秒）：太快像脚本，太慢当卡住
# FIZZ_CAPTCHA_MIN_ELAPSED_MS=200
# FIZZ_CAPTCHA_MAX_ELAPSED_MS=60000
# 签发限流：每 IP 每窗口最多签发多少张（一张要真画图 + deflate，不限流等于廉价 DoS）
# FIZZ_CAPTCHA_ISSUE_MAX=30
# FIZZ_CAPTCHA_ISSUE_WINDOW_SEC=60

# 限流（滑动窗口，按客户端 IP 计）：拦「拿固定账号反复试密码」的暴力破解。
# 鉴权启用时默认开，设 FIZZ_RATE_LIMIT=0/false/off 关闭。
# 登录尝试：默认每 IP 60 秒 10 次。
# 超限返回 429 + Retry-After，响应体带 code: 'rate-limited'。
# FIZZ_RATE_LIMIT=0
# FIZZ_LOGIN_RATE_MAX=10
# FIZZ_LOGIN_RATE_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# 服务监听（Docker 部署时由 docker-compose.yml 接管，这里一般不用改）
# ---------------------------------------------------------------------------
# 绑 0.0.0.0 才能被外部访问；本机开发保持 127.0.0.1
# FIZZ_HOST=127.0.0.1
# FIZZ_PORT=7801
# 数据目录：配置 / 会话 / 加密后的 API key，缺省 ~/.fizz-server
# FIZZ_DATA_DIR=

# 全局规则目录（读其中的 AGENTS.md / CLAUDE.md），缺省 $XDG_CONFIG_HOME/fizz 或 ~/.config/fizz
# FIZZ_CONFIG_DIR=

# 加密 API key 的主密钥，32 字节 base64：openssl rand -base64 32
# 不设则用数据目录里的 secret.key；换了它，已存的 API key 需要重新填一次
# FIZZ_SECRET_KEY=

# 跨域白名单（逗号分隔）。同源托管 web 页面时不需要配；
# 只有本地 vite dev（5173/5178）直连远端 server 才要加。
# FIZZ_CORS_ORIGINS=http://localhost:5173

# 静态托管的 web 产物目录，缺省 apps/web/dist（相对 server 产物位置）
# FIZZ_WEB_DIR=

# 设为 1 时不读 .env（端到端验证用，避免本地配置影响断言）
# FIZZ_SKIP_ENV_FILE=1

# 子任务（subagent）空闲看门狗：派活后多久没有任何子任务事件就中止本轮
# （默认 120000 = 2 分钟；0 = 关闭）。慢模型 / 超大仓库可调大。
# ⚠️ Mastra 的 delegation 没有单独取消句柄，触发时会中止整轮并给出明确报错。
# FIZZ_SUBAGENT_IDLE_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# 移动端（apps/mobile 的 Capacitor 安卓壳）
# ---------------------------------------------------------------------------
# 服务端地址**不在构建期配置**：登录页填写后保存到本机（`fizz.mobile.serverUrl`），
# 同一个 APK 可以连不同服务器。`?server=http://host:port` 仍可用于临时覆盖。
# 安卓端已允许明文流量（局域网 http server 常见），生产仍建议 https。

# ---------------------------------------------------------------------------
# Docker Compose 专用
# ---------------------------------------------------------------------------
# 宿主机映射端口
# FIZZ_PORT=7801
# 给 agent 操作的宿主机目录（容器里挂成 /workspace）。
# ⚠️ 注册工作区时填容器内路径 /workspace，不是这里的宿主机路径。
# FIZZ_WORKSPACE=/srv/my-project
# TZ=Asia/Shanghai

# 容器内运行身份：填宿主机用户的 uid / gid（`id -u` / `id -g`）。
# 设了之后，容器里新建的文件在宿主机上就属于你（不会变成 root 的），
# git 也不会再报「dubious ownership」。留 0:0 = 以前的 root 行为。
# ⚠️ 同时把工作区目录也改成这个属主：sudo chown -R $(id -u):$(id -g) <目录>
# PUID=1000
# PGID=1000

# ---------------------------------------------------------------------------
# 容器型项目（每项目一个独立容器，AI 操作全在容器内，宿主↔容器走回环）
# ---------------------------------------------------------------------------
# 项目目录根：每个容器型项目一个随机 slug 子目录（目录名 = 容器名 = 公网子域标签，
# 三合一）。缺省 <数据目录>/containers。⚠️ 目录由系统固定，用户不可自定义。
# FIZZ_CONTAINER_PROJECTS_ROOT=
# 容器不会自己停：起停都由用户决定（项目菜单的「停止容器」/「重启容器」）。
# 冷启动时等容器内 Agent 就绪的上限（毫秒），缺省 60000。
# FIZZ_CONTAINER_WAKE_TIMEOUT_MS=60000
# 容器镜像缺省 tag 可逐个环境覆盖：环境 id 大写接在 FIZZ_CONTAINER_IMAGE_ 后
# （node / php / golang → FIZZ_CONTAINER_IMAGE_NODE / _PHP / _GOLANG）。
# 缺省就是内置清单里的 fizz/agent-<环境>:latest，一般不用配。
# FIZZ_CONTAINER_IMAGE_PHP=

# --- 公网访问（把每个项目的预览服务挂到 `*.<域名>` 下）---
# 公网入口是**独立的一个监听端口**，与工作台端口分开。默认关闭（`0`）。
# 想对外暴露预览就配一个端口（如 7802），再在防火墙 / 反代里放行它。
# FIZZ_PUBLIC_HTTP_PORT=7802
# 域名**只在 设置 → 容器 → 公网访问 里填**（可填多个），没有环境变量。
# 泛解析的域名，去掉 `*.` 只填主域（如 `example.com`，不是 `*.example.com`）。
# 设置页「解析到」那一栏显示的地址；不填就取本机第一个非回环 IPv4。
# FIZZ_PUBLIC_IP=
#
# 启用的两道闸：① 设置里至少填了一个域名；② `FIZZ_PUBLIC_HTTP_PORT` 配了且端口在监听。
# 只有 `<slug>.<配置域名>`（**正好一层**子域）且该 slug 真有容器项目时才反代到容器；
# 其余一切 Host 一律 404、**绝不回落**到工作台（这个端口上没有工作台）。
#
# 启用后的链路：
#   1. 在 DNS 把每个 `*.<域名>` 泛解析到这台机器；
#   2. 放一个自备的反代（nginx / caddy / cloudflared …）监听 443、**在这一层终结 TLS**，
#      把 `*.<域名>`（或按需精确到某个子域）转发到 `127.0.0.1:FIZZ_PUBLIC_HTTP_PORT`，
#      并透传 `Host` 头与 WebSocket 升级（容器内的前端 dev server 要走 HMR）；
#   3. 在某个容器型项目的「预览」标签里打开「对外发布」——发布是个**显式动作、默认关**。
#   然后 `https://<slug>.<域名>` 就能打开该项目的预览服务（裸访问 `http://` 也行，
#   只是本进程只监听明文）。
#
# ⚠️ 创建项目时填的「预览端口」是**容器内**的端口；用它的应用必须监听该端口、并且绑
#    `0.0.0.0`（绑 127.0.0.1 / localhost 时 docker 的端口转发进不到容器里，页面空白且
#    无任何报错）。宿主侧那个随机的 127.0.0.1 映射端口由系统自动分配，不用配。
